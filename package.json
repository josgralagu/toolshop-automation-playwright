{
  "name": "toolshop-automation-playwright",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test:cucumber": "npx cucumber-js --config cucumber/config/default.js --format html:reports/cucumber/chrome/cucumber-report.html --format json:reports/cucumber/chrome/cucumber-report.json cucumber/features/*.feature",
    "test:cucumber:chrome": "npx cucumber-js --config cucumber/config/default.js --format html:reports/cucumber/chrome/cucumber-report.html --format json:reports/cucumber/chrome/cucumber-report.json cucumber/features/*.feature",
    "test:cucumber:firefox": "npx cucumber-js --config cucumber/config/default.js --format html:reports/cucumber/firefox/cucumber-report.html --format json:reports/cucumber/firefox/cucumber-report.json cucumber/features/*.feature --world-parameters \"{\\\"browser\\\": \\\"firefox\\\"}\"",
    "test:cucumber:both": "start npm run test:cucumber:chrome && npm run test:cucumber:firefox",
    "test:cucumber:smoke": "npx cucumber-js --config cucumber/config/default.js --format html:reports/cucumber/cucumber-smoke-report.html --format json:reports/cucumber/cucumber-smoke-report.json cucumber/features/*.feature --tags \"@smoke\"",
    "test:cucumber:regression": "npx cucumber-js --config cucumber/config/default.js --format html:reports/cucumber/cucumber-regression-report.html --format json:reports/cucumber/cucumber-regression-report.json cucumber/features/*.feature --tags \"@regression\"",
    "test:cucumber:critical": "npx cucumber-js --config cucumber/config/default.js --format html:reports/cucumber/cucumber-critical-report.html --format json:reports/cucumber/cucumber-critical-report.json cucumber/features/*.feature --tags \"@critical\"",
    "test:cucumber:profile": "npx cucumber-js --config cucumber/config/profile.js --format html:reports/cucumber/cucumber-profile-report.html --format json:reports/cucumber/cucumber-profile-report.json cucumber/features/*.feature",
    "test:cucumber:product": "npx cucumber-js --config cucumber/config/product.js --format html:reports/cucumber/cucumber-product-report.html --format json:reports/cucumber/cucumber-product-report.json cucumber/features/*.feature",
    "test:cucumber:favorites": "npx cucumber-js --config cucumber/config/favorites.js --format html:reports/cucumber/cucumber-favorites-report.html --format json:reports/cucumber/cucumber-favorites-report.json cucumber/features/*.feature",
    "test:cucumber:filters": "npx cucumber-js --config cucumber/config/filters.js --format html:reports/cucumber/cucumber-filters-report.html --format json:reports/cucumber/cucumber-filters-report.json cucumber/features/*.feature",
    "test:cucumber:language": "npx cucumber-js --config cucumber/config/language.js --format html:reports/cucumber/cucumber-language-report.html --format json:reports/cucumber/cucumber-language-report.json cucumber/features/*.feature",
    "test:cucumber:ui": "npx cucumber-js --config cucumber/config/default.js --format html:reports/cucumber/cucumber-ui-report.html --format json:reports/cucumber/cucumber-ui-report.json cucumber/features/*.feature --tags \"@ui\"",
    "test:cucumber:dry": "npx cucumber-js --config cucumber/config/default.js cucumber/features/*.feature --dry-run",
    "test:cucumber:report": "start reports/cucumber/chrome/cucumber-report.html",
    "test:cucumber:report:chrome": "start reports/cucumber/chrome/cucumber-report.html",
    "test:cucumber:report:firefox": "start reports/cucumber/firefox/cucumber-report.html",
    "test:playwright": "npx playwright test --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:file": "npx playwright test src/tests/playwright-tests/example.spec.js --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:headed": "npx playwright test --headed --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:ui": "npx playwright test --ui --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:chrome": "npx playwright test --project=chromium --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:firefox": "npx playwright test --project=firefox --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:msedge": "npx playwright test --project=msedge --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:debug": "npx playwright test --debug --config=src/configs/playwrightConfigs/playwright.config.js",
    "test:playwright:report": "npx playwright show-report reports/ui/playwright-reports",
    "test:mocha": "npx mocha src/tests/mocha-chai-tests/**/*.spec.js --config src/configs/mochaConfigs/.mocharc.json --reporter-options reportDir=reports/ui/mocha-reports,reportFilename=toolshop-test-[status]_[datetime],overwrite=false,quiet=true,code=true,charts=true,autoOpen=true,showHooks=always",
    "test:mocha:file": "npx mocha src/tests/mocha-chai-tests/example.spec.js --config src/configs/mochaConfigs/.mocharc.json --reporter-options reportDir=reports/ui/mocha-reports,reportFilename=single_spec-[status]_[datetime]-report,overwrite=false,quiet=true,code=true,charts=true,autoOpen=true,showHooks=always",
    "test:mocha:watch": "npx mocha src/tests/mocha-chai-tests/**/*.spec.js --watch --config src/configs/mochaConfigs/.mocharc.json",
    "test:mocha:specreporter": "npx mocha src/tests/mocha-chai-tests/**/*.spec.js --reporter spec --config src/configs/mochaConfigs/.mocharc.json",
    "test:mocha:serial": "npx mocha src/tests/mocha-chai-tests/**/*.spec.js --parallel false --config src/configs/mochaConfigs/.mocharc.json --reporter-options reportDir=reports/ui/mocha-reports,reportFilename=toolshop-test-[status]_[datetime],overwrite=false,quiet=true,code=true,charts=true,autoOpen=true,showHooks=always",
    "test:mocha:grep": "npx mocha src/tests/mocha-chai-tests/**/*.spec.js --config src/configs/mochaConfigs/.mocharc.json --grep",
    "test:ui": "npm run test:playwright && npm run test:mocha",
    "test:ui:headed": "npm run test:playwright:headed && npm run test:mocha",
    "test:ui:parallel": "npm run test:playwright & npm run test:mocha",
    "test:api": "npx mocha api/tests/**/*.spec.js --config api/configs/.mocharc.json --reporter-options reportDir=reports/api/mocha-reports,reportFilename=api-test-[status]_[datetime],overwrite=false,quiet=true,code=true,charts=true,autoOpen=true,showHooks=always",
    "format:ui:playwright": "npx prettier --write src/tests/playwright-tests/ src/po/ src/configs/utils/ src/configs/playwrightConfigs/fixtures/",
    "lint:ui:playwright": "npx eslint src/tests/playwright-tests/ src/po/ src/configs/utils/ src/configs/playwrightConfigs/fixtures/",
    "format&lint:ui:playwright": "npm run format:ui:playwright && npm run lint:ui:playwright",
    "fix:ui:playwright": "npx eslint --fix src/tests/playwright-tests/ src/po/ src/configs/utils/ src/configs/playwrightConfigs/fixtures/",
    "format:ui:mocha": "npx prettier --write src/tests/mocha-chai-tests/ src/po/ src/configs/utils/ src/configs/mochaConfigs/",
    "lint:ui:mocha": "npx eslint src/tests/mocha-chai-tests/ src/po/ src/configs/utils/ src/configs/mochaConfigs/",
    "format&lint:ui:mocha": "npm run format:ui:mocha && npm run lint:ui:mocha",
    "fix:ui:mocha": "npx eslint --fix src/tests/mocha-chai-tests/ src/po/ src/configs/utils/ src/configs/mochaConfigs/",
    "format:ui": "npm run format:ui:playwright && npx prettier --write src/tests/mocha-chai-tests/ src/configs/mochaConfigs/",
    "lint:ui": "npm run lint:ui:playwright && npm run lint:ui:mocha",
    "format&lint:ui": "npm run format:ui && npm run lint:ui",
    "fix:ui": "npm run fix:ui:playwright && npm run fix:ui:mocha",
    "format:api": "npx prettier --write api/",
    "lint:api": "npx eslint api/",
    "fix:api": "npx eslint --fix api/tests/ api/business/ api/configs/ api/utilities/",
    "format:project": "npx prettier --write .",
    "lint:project": "npx eslint .",
    "format&lint:project": "npm run format:project && npm run lint:project",
    "fix:project": "npx eslint --fix"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "José Emmanuel Grajales Lagunes",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "@eslint/js": "9.39.1",
    "@eslint/json": "0.14.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^20.19.30",
    "chai": "6.2.1",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-playwright": "2.4.0",
    "globals": "16.5.0",
    "joi": "18.0.2",
    "mocha": "11.7.5",
    "mochawesome": "7.1.4",
    "playwright": "1.56.1",
    "prettier": "3.7.4",
    "supertest": "7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "should": "^13.2.3"
  }
}
